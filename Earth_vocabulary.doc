    <tr><td>coastline</td><td>/ˈkəʊstlaɪn/</td><td>n. 海岸线</td></tr>
    <tr><td>navigation</td><td>/ˌnævɪˈɡeɪʃn/</td><td>n. 航行；导航</td></tr>
    <tr><td>gulf</td><td>/ɡʌlf/</td><td>n. 海湾</td></tr>
    <tr><td>coast</td><td>/kəʊst/</td><td>n. 海岸</td></tr>
    <tr><td>shore</td><td>/ʃɔː(r)/</td><td>n. 岸，滨</td></tr>
    <tr><td>tide</td><td>/taɪd/</td><td>n. 潮汐；潮流</td></tr>
