  <h1>Earth Vocabulary Lists</h1>

  <h2>List 1 地球结构 &amp; 大气</h2>
  <table>
    <tr><th>单词</th><th>音标</th><th>词性 &amp; 中文释义</th></tr>
    <tr><td>atmosphere</td><td>/ˈætməsfɪə(r)/</td><td>n. 大气；大气层；氛围</td></tr>
    <tr><td>lithosphere</td><td>/ˈlɪθəsfɪə(r)/</td><td>n. 岩石圈</td></tr>
    <tr><td>hydrosphere</td><td>/ˈhaɪdrəsfɪə(r)/</td><td>n. 水圈</td></tr>
    <tr><td>oxygen</td><td>/ˈɒksɪdʒən/</td><td>n. 氧气</td></tr>
    <tr><td>oxide</td><td>/ˈɒksaɪd/</td><td>n. 氧化物</td></tr>
    <tr><td>hydrogen</td><td>/ˈhaɪdrədʒən/</td><td>n. 氢气</td></tr>
    <tr><td>crust</td><td>/krʌst/</td><td>n. 地壳；外壳</td></tr>
    <tr><td>mantle</td><td>/ˈmæntl/</td><td>n. 地幔；斗篷</td></tr>
    <tr><td>longitude</td><td>/ˈlɒŋɡɪtjuːd/</td><td>n. 经度</td></tr>
    <tr><td>latitude</td><td>/ˈlætɪtjuːd/</td><td>n. 纬度</td></tr>
    <tr><td>horizon</td><td>/həˈraɪzn/</td><td>n. 地平线；眼界</td></tr>
    <tr><td>altitude</td><td>/ˈæltɪtjuːd/</td><td>n. 海拔，高度</td></tr>
    <tr><td>disaster</td><td>/dɪˈzɑːstə(r)/</td><td>n. 灾难</td></tr>
    <tr><td>mishap</td><td>/ˈmɪshæp/</td><td>n. 小事故，灾祸</td></tr>
    <tr><td>catastrophic</td><td>/ˌkætəˈstrɒfɪk/</td><td>adj. 灾难性的</td></tr>
    <tr><td>calamity</td><td>/kəˈlæməti/</td><td>n. 大灾难，灾祸</td></tr>
    <tr><td>endanger</td><td>/ɪnˈdeɪndʒə(r)/</td><td>v. 危及，使遭受危险</td></tr>
    <tr><td>jeopardise</td><td>/ˈdʒepədaɪz/</td><td>v. 危害，损害（=jeopardize）</td></tr>
    <tr><td>destructive</td><td>/dɪˈstrʌktɪv/</td><td>adj. 毁灭性的</td></tr>
    <tr><td>phenomenon</td><td>/fəˈnɒmɪnən/</td><td>n. 现象（pl. phenomena）</td></tr>
    <tr><td>El Niño</td><td>/el ˈniːnjəʊ/</td><td>n. 厄尔尼诺现象</td></tr>
    <tr><td>greenhouse</td><td>/ˈɡriːnhaʊs/</td><td>n. 温室；暖房</td></tr>
    <tr><td>pebble</td><td>/ˈpebl/</td><td>n. 卵石，小圆石</td></tr>
    <tr><td>magnet</td><td>/ˈmæɡnət/</td><td>n. 磁铁；磁体</td></tr>
    <tr><td>ore</td><td>/ɔː(r)/</td><td>n. 矿石</td></tr>
    <tr><td>mineral</td><td>/ˈmɪnərəl/</td><td>n. 矿物；adj. 矿物的</td></tr>
    <tr><td>marble</td><td>/ˈmɑːbl/</td><td>n. 大理石</td></tr>
    <tr><td>quartz</td><td>/kwɔːts/</td><td>n. 石英</td></tr>
    <tr><td>granite</td><td>/ˈɡrænɪt/</td><td>n. 花岗岩</td></tr>
    <tr><td>gust</td><td>/ɡʌst/</td><td>n. 一阵狂风；v. 猛刮</td></tr>
    <tr><td>breeze</td><td>/briːz/</td><td>n. 微风</td></tr>
    <tr><td>monsoon</td><td>/ˌmɒnˈsuːn/</td><td>n. 季风</td></tr>
    <tr><td>gale</td><td>/ɡeɪl/</td><td>n. 大风，狂风</td></tr>
    <tr><td>hurricane</td><td>/ˈhʌrɪkən/</td><td>n. 飓风</td></tr>
    <tr><td>tornado</td><td>/tɔːˈneɪdəʊ/</td><td>n. 龙卷风</td></tr>
    <tr><td>typhoon</td><td>/taɪˈfuːn/</td><td>n. 台风</td></tr>
    <tr><td>volcano</td><td>/vɒlˈkeɪnəʊ/</td><td>n. 火山</td></tr>
    <tr><td>erupt</td><td>/ɪˈrʌpt/</td><td>v.（火山）爆发；喷发</td></tr>
    <tr><td>magma</td><td>/ˈmæɡmə/</td><td>n. 岩浆</td></tr>
    <tr><td>thermodynamic</td><td>/ˌθɜːməʊdaɪˈnæmɪk/</td><td>adj. 热力学的</td></tr>
    <tr><td>smog</td><td>/smɒɡ/</td><td>n. 烟雾</td></tr>
    <tr><td>fume</td><td>/fjuːm/</td><td>n.（浓烈的）烟，气；v. 冒烟</td></tr>
    <tr><td>mist</td><td>/mɪst/</td><td>n. 薄雾</td></tr>
    <tr><td>tsunami</td><td>/tsuːˈnɑːmi/</td><td>n. 海啸</td></tr>
    <tr><td>drought</td><td>/draʊt/</td><td>n. 干旱</td></tr>
    <tr><td>flooding</td><td>/ˈflʌdɪŋ/</td><td>n. 洪水泛滥</td></tr>
    <tr><td>torrent</td><td>/ˈtɒrənt/</td><td>n. 激流，洪流</td></tr>
    <tr><td>earthquake</td><td>/ˈɜːθkweɪk/</td><td>n. 地震</td></tr>
    <tr><td>seismic</td><td>/ˈsaɪzmɪk/</td><td>adj. 地震的；有关地震的</td></tr>
    <tr><td>avalanche</td><td>/ˈævəlɑːnʃ/</td><td>n. 雪崩</td></tr>
    <tr><td>terrain</td><td>/təˈreɪn/</td><td>n. 地形，地势</td></tr>
    <tr><td>landscape</td><td>/ˈlændskeɪp/</td><td>n. 风景；地貌</td></tr>
    <tr><td>continent</td><td>/ˈkɒntɪnənt/</td><td>n. 大陆，洲</td></tr>
    <tr><td>cave</td><td>/keɪv/</td><td>n. 洞穴</td></tr>
    <tr><td>cliff</td><td>/klɪf/</td><td>n. 悬崖，峭壁</td></tr>
    <tr><td>glacier</td><td>/ˈɡlæsiə(r)/</td><td>n. 冰川，冰河</td></tr>
    <tr><td>swamp</td><td>/swɒmp/</td><td>n. 沼泽，湿地</td></tr>
    <tr><td>delta</td><td>/ˈdeltə/</td><td>n. 三角洲</td></tr>
  </table>

  <h2>List 2 地形 &amp; 海陆</h2>
  <table>
    <tr><th>单词</th><th>音标</th><th>词性 &amp; 中文释义</th></tr>
